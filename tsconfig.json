{
	"compilerOptions": {
		// "preserve" + "bundler" is the pairing for code that is bundled by
		// esbuild: tsc only type-checks here (`tsc --noEmit --watch`), it never
		// emits. It also honours package "exports" maps, which is required by
		// typescript-eslint, whose index.d.ts re-exports from the
		// "@typescript-eslint/utils/ts-eslint" subpath export.
		"module": "preserve",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"target": "ES2022",
		"lib": [
			"ES2022",
			"DOM"
		],
		"types": ["node"],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,   /* enable all strict type-checking options */
		/* Additional Checks */
		// "noImplicitReturns": true, /* Report error when not all code paths in function return a value. */
		// "noFallthroughCasesInSwitch": true, /* Report errors for fallthrough cases in switch statement. */
		// "noUnusedParameters": true,  /* Report errors on unused parameters. */
	}
}
