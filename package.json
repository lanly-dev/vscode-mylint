{
  "name": "mylint",
  "displayName": "MyLint",
  "description": "Just another TS/JS Linter and Formatter",
  "publisher": "lanly-dev",
  "version": "0.0.3",
  "sponsor": {
    "url": "https://github.com/sponsors/lanly-dev"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "eslint",
    "formatter",
    "javascript",
    "JS",
    "lint",
    "mylint",
    "TS",
    "typescript"
  ],
  "icon": "media/mylint.png",
  "galleryBanner": {
    "color": "#fff",
    "theme": "light"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mylint.openConfig",
        "title": "MyLint: Open Global ESLint Configuration File"
      },
      {
        "command": "mylint.openSettings",
        "title": "MyLint: Open Settings"
      },
      {
        "command": "mylint.formatFile",
        "title": "MyLint: Format File"
      }
    ],
    "configuration": {
      "title": "MyLint",
      "properties": {
        "myLint.enableDiagnostics": {
          "type": "boolean",
          "default": false,
          "description": "Enable/disable showing lint diagnostics in VS Code's Problems tab."
        },
        "mylint.rules": {
          "type": "object",
          "default": {},
          "description": "ESLint rule overrides for JS/TS files. Ex: (e.g. \"semi\": [\"error\", \"always\"]).",
          "additionalProperties": true
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "mylint.formatFile",
          "group": "1_modification",
          "when": "editorTextFocus && editorLangId =~ /^(typescript|javascript)$/ && !mylint.isDefaultFormatter"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "webpack",
    "package": "webpack --mode production --devtool hidden-source-map",
    "watch": "webpack --watch",
    "vsce-package": "vsce package",
    "efix": "eslint . --fix",
    "bundle": "node esbuild.config.mjs"
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.12.0",
    "typescript-eslint": "^8.71.2"
  },
  "devDependencies": {
    "@types/node": "26.x",
    "@types/vscode": "^1.140.0",
    "ovsx": "^1.2.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "esbuild": "^0.28.2",
    "jiti": "^2.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanly-dev/vscode-mylint.git"
  },
  "bugs": {
    "url": "https://github.com/lanly-dev/vscode-mylint/issues"
  },
  "license": "MIT"
}
